# MR.Engineers Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

# Gmail Inquiries Configuration
# To receive every website inquiry directly into mrengineers.contact@gmail.com:
# 1. Sign in to https://myaccount.google.com/ with mrengineers.contact@gmail.com
# 2. Under "Security", make sure 2-Step Verification is turned ON
# 3. Search for "App passwords" (or visit: https://myaccount.google.com/apppasswords)
# 4. Enter app name "MR.Engineers Website" and click "Create"
# 5. Copy the generated 16-character password and paste it below:
GMAIL_USER=mrengineers.contact@gmail.com
GMAIL_APP_PASSWORD=

# Deployment Base URL
NEXT_PUBLIC_BASE_URL=https://mrengineers.in
